# Default development environment for `pnpm dev`.
# MSW intercepts /api/* with the in-memory mock DB so the SPA runs offline.
VITE_USE_MOCK=true

# API base URL — when VITE_USE_MOCK=false, requests go through the Vite proxy
# to the real dt-console-server on :8080. Override with VITE_API_BASE for remote.
VITE_API_BASE=/api
