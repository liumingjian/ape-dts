# Copy to .env.production (or .env.production.local) for real-backend builds.
# When unset (or set to anything other than "true"), the production bundle
# excludes the entire MSW layer — see src/main.ts.
VITE_USE_MOCK=false

# API base URL for the production build.
# Override when the SPA is served from a different origin than the backend.
VITE_API_BASE=/api
