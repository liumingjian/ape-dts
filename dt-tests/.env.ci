# Environment for the CI integration-test stack. Copied to `tests/.env` by the E2E workflow.
#
# Paired with `docker-compose.ci.yml`: every endpoint below is a service in that file, and
# `tests/test_runner/env_ci.rs` fails if any `{placeholder}` used by a task_config.ini is
# missing here. A key may be defined and still not provisioned (the services below the
# "not provisioned" line): those suites skip on the TCP probe instead of dying on a missing
# variable — see dt-tests/README.md, "Environment guards".
#
# Credentials are test-only and identical to the ones baked into docker-compose.ci.yml.

# ── mysql (profile: mysql) ───────────────────────────────────────────────────────
mysql_extractor_url=mysql://root:123456@127.0.0.1:3307?ssl-mode=disabled
mysql_sinker_url=mysql://root:123456@127.0.0.1:3308?ssl-mode=disabled
mysql_meta_center_url=mysql://root:123456@127.0.0.1:3309?ssl-mode=disabled

mysql_extractor_url_8_0=mysql://root:123456@127.0.0.1:3311?ssl-mode=disabled
mysql_sinker_url_8_0=mysql://root:123456@127.0.0.1:3312?ssl-mode=disabled

case_sensitive_mysql_extractor_url=mysql://root:123456@127.0.0.1:3311?ssl-mode=disabled
case_sensitive_mysql_sinker_url=mysql://root:123456@127.0.0.1:3312?ssl-mode=disabled

mysql_cycle_node1_url=mysql://root:123456@127.0.0.1:3307?ssl-mode=disabled
mysql_cycle_node2_url=mysql://root:123456@127.0.0.1:3308?ssl-mode=disabled
mysql_cycle_node3_url=mysql://root:123456@127.0.0.1:3309?ssl-mode=disabled

mysql_extractor_without_auth_url=mysql://127.0.0.1:3307?ssl-mode=disabled
mysql_extractor_username=root
mysql_extractor_password=123456
mysql_sinker_without_auth_url=mysql://127.0.0.1:3308?ssl-mode=disabled
mysql_sinker_username=root
mysql_sinker_password=123456

# ── pg (profile: pg) ─────────────────────────────────────────────────────────────
pg_extractor_url=postgres://postgres:postgres@127.0.0.1:5433/postgres?options[statement_timeout]=10s
pg_sinker_url=postgres://postgres:postgres@127.0.0.1:5434/postgres?options[statement_timeout]=10s

pg_cycle_node1_url=postgres://postgres:postgres@127.0.0.1:5433/postgres?options[statement_timeout]=10s
pg_cycle_node2_url=postgres://postgres:postgres@127.0.0.1:5434/postgres?options[statement_timeout]=10s
pg_cycle_node3_url=postgres://postgres:postgres@127.0.0.1:5435/postgres?options[statement_timeout]=10s

pg_extractor_without_auth_url=postgres://127.0.0.1:5433/postgres?options[statement_timeout]=10s
pg_extractor_username=postgres
pg_extractor_password=postgres
pg_sinker_without_auth_url=postgres://127.0.0.1:5434/postgres?options[statement_timeout]=10s
pg_sinker_username=postgres
pg_sinker_password=postgres

# ── mongo (profile: mongo) ───────────────────────────────────────────────────────
# The source runs without auth, so its username/password are empty on purpose: an empty
# credential leaves the url untouched (ConnectionAuthConfig::merge_url_with_auth), while a
# bogus one would make every connection fail against a server that has no such user.
mongo_extractor_url=mongodb://127.0.0.1:27017
mongo_sinker_url=mongodb://ape_dts:123456@127.0.0.1:27018

mongo_extractor_without_auth_url=mongodb://127.0.0.1:27017
mongo_extractor_username=
mongo_extractor_password=
mongo_sinker_without_auth_url=mongodb://127.0.0.1:27018
mongo_sinker_username=ape_dts
mongo_sinker_password=123456

